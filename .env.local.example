# 이 파일을 복사해서 이름을 .env.local 로 바꾼 뒤, 오른쪽 값을 채우세요.
# .env.local 은 비밀 정보라서 인터넷(깃허브 등)에 올라가지 않습니다.

# Supabase → Project Settings → API (또는 Connect) 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에_publishable_또는_anon_키

# (선택) 접수 확인 메일 보내기 — Resend → API Keys 에서 만든 키
RESEND_API_KEY=
# 보내는 사람 주소. Resend 에서 tedoori.com 도메인 인증을 마친 뒤 사용
MAIL_FROM=테두리 <contact@tedoori.com>
# 고객이 접수 메일에 "회신"하면 이 주소로 갑니다 (실제로 받는 메일함, 예: 지메일)
MAIL_REPLY_TO=
# 새 신청이 들어오면 알림을 받을 운영자 이메일
OPERATOR_EMAIL=
